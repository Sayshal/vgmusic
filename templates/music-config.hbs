<div class="vgmusic-sections">
  {{#if rows.length}}
    <ol class="section-rows">
      <li class="section-row column-headers">
        <span>{{localize "VGMusic.Section"}}</span>
        <span>{{localize "VGMusic.Playlist"}}</span>
        <span>{{localize "VGMusic.InitialTrack"}}</span>
        <span class="priority">{{localize "VGMusic.Priority"}}</span>
        <span></span>
      </li>
      {{#each rows as |row|}}
        <li class="section-row" data-section="{{row.id}}" data-item-id="{{row.playlistId}}">
          <span class="section-label">{{row.label}}</span>
          <button type="button" class="playlist-name" data-action="openPlaylist"
            data-tooltip="{{localize 'PLAYLIST.ViewSheet'}}">
            <i class="fas fa-music"></i>
            <span>{{row.playlistName}}</span>
          </button>
          <span class="track-name">{{row.trackName}}</span>
          <span class="priority">{{row.priority}}</span>
          <span class="row-controls">
            <button type="button" data-action="configureSection"
              data-tooltip="{{localize 'VGMusic.SectionConfig.Edit'}}">
              <i class="fas fa-pen"></i>
            </button>
            <button type="button" data-action="deletePlaylist" data-tooltip="{{localize 'Delete'}}">
              <i class="fas fa-trash"></i>
            </button>
          </span>
        </li>
      {{/each}}
    </ol>
  {{/if}}
  <p class="hint">{{localize "VGMusic.ConfigHelp"}}</p>
</div>
